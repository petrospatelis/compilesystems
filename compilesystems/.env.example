# Copy to .env.local for local development.

# Public site URL used for canonical links, sitemap, and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://compilesystems.com

# Resend (contact form email delivery)
RESEND_API_KEY=
# Use onboarding@resend.dev for local testing, or a verified domain address in production.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Defaults to info@compilesystems.com when unset.
# With onboarding@resend.dev, Resend only delivers to your account email until a domain is verified.
RESEND_TO_EMAIL=petrospatelis@gmail.com
